import javax.swing.*;
import javax.crypto.*;
import javax.crypto.spec.SecretKeySpec;

public class Blowfish {

    static byte[] key;

    public static void generateKey() throws Exception {
        KeyGenerator kg = KeyGenerator.getInstance("Blowfish");
        kg.init(128);
        SecretKey sk = kg.generateKey();
        key = sk.getEncoded();
    }

    public static byte[] encrypt(byte[] data) throws Exception {
        SecretKeySpec ks = new SecretKeySpec(key, "Blowfish");
        Cipher cipher = Cipher.getInstance("Blowfish");
        cipher.init(Cipher.ENCRYPT_MODE, ks);
        return cipher.doFinal(data);
    }

    public static byte[] decrypt(byte[] data) throws Exception {
        SecretKeySpec ks = new SecretKeySpec(key, "Blowfish");
        Cipher cipher = Cipher.getInstance("Blowfish");
        cipher.init(Cipher.DECRYPT_MODE, ks);
        return cipher.doFinal(data);
    }

    public static void main(String[] args) {
        try {
            generateKey();

            String msg = JOptionPane.showInputDialog("Enter Message");

            byte[] enc = encrypt(msg.getBytes());
            JOptionPane.showMessageDialog(null, "Encrypted Data:\n" + new String(enc));

            byte[] dec = decrypt(enc);
            JOptionPane.showMessageDialog(null, "Decrypted Data:\n" + new String(dec));

        } catch (Exception e) {
            System.out.println(e);
        }
    }
}